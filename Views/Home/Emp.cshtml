@model WP3.Models.ApiMod
@{
    ViewData["Title"] = Model.pTitle;
}
<section class="intro">
    <h1>@Model.emp.introduction.title</h1>
    <br />
    <!--All the non-table stuff-->
    @foreach(var content in Model.emp.introduction.content)
    {
        <div class="box">
            <h2>@content.title</h2>
            <p>@content.description</p>
        </div>
    }
    <div class="box">
        <h2>@Model.emp.degreeStatistics.title</h2>
                @foreach (var stat in Model.emp.degreeStatistics.statistics)
                {
                        <span><strong>@stat.value</strong></span>
                        <span>@stat.description</span>
                        <p></p>
                }
    </div>
    <div class="box">
        <h2>@Model.emp.employers.title</h2>
        @foreach (var emp in Model.emp.employers.employerNames)
        {
            <p>@emp</p>

        }
       
    </div>
    <div class="box">
        <h2>@Model.emp.careers.title</h2>
        @foreach (var car in Model.emp.careers.careerNames)
        {
            <p>@car</p>

        }

    </div>
    <div class="Tables">
        <!--Coop table-->
            <h2>@Model.emp.coopTable.title</h2>
            <table id="coopTable" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th>Employer</th>
                        <th>Degree</th>
                        <th>City</th>
                        <th>Term</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coop in Model.emp.coopTable.coopInformation)
                    {
                        <tr>
                            <td>@coop.employer</td>
                            <td>@coop.degree</td>
                            <td>@coop.city</td>
                            <td>@coop.term</td>
                        </tr>
                    }
                </tbody>
            </table>
        <h2>@Model.emp.employmentTable.title</h2>
        <table id="employmentTable" class="display" style="width:100%">
            <thead>
                <tr>
                    <th>Employer</th>
                    <th>Degree</th>
                    <th>City</th>
                    <th>Title</th>
                    <th>Start Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employment in Model.emp.employmentTable.professionalEmploymentInformation)
                {
                    <tr>
                        <td>@employment.employer</td>
                        <td>@employment.degree</td>
                        <td>@employment.city</td>
                        <td>@employment.title</td>
                        <td>@employment.startDate</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
<div class="map">
    <h2>Map</h2>
    @Html.Raw(Model.map)
</div>