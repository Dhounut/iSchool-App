<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WP3</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WP3.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/jquery-datatables/dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/jqueryui/jquery-ui.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ISchool</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark @(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(ViewContext.RouteData.Values["action"].ToString() == "Deg" ? "active fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="Deg">Degrees</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(ViewContext.RouteData.Values["action"].ToString() == "Emp" ? "active fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="Emp">Employment</a>
                        </li>
                        <li class="nav-item">
                        <a class="nav-link text-dark @(ViewContext.RouteData.Values["action"].ToString() == "Pep" ? "active fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="Pep">People</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            <h3>@Model.foot.social.title</h3>
            <div class="tweet"><p>@Model.foot.social.tweet</p>
                <p>@Model.foot.social.by</p>
            </div>
            <p>@Model.foot.social.twitter</p>
            <p>@Model.foot.social.facebook</p>
        </div>
        <div class="container">
            <h3>Quick Links</h3>
            @foreach (var quickLinks in Model.foot.quickLinks)
            {
                <h5><a href="@quickLinks.href">@quickLinks.title</a></h5>
            }
        </div>
        <div class="container">
            <h3>@Model.foot.copyright.title</h3>
            @Html.Raw(Model.foot.copyright.html)
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/jqueryui/jquery-ui.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-datatables/dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
